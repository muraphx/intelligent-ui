# Optional: offline demos need no API key or proxy.
# Copy to .env, choose a provider, supply your own key AND a model available to your account.
# Restart `npm run proxy` after editing. Never use VITE_ prefixes for secrets.
UI_PROVIDER=openai

# OpenAI-compatible Chat Completions endpoint. Include /v1 when your endpoint requires it.
# HTTPS is required except for HTTP endpoints on localhost / 127.0.0.1 / ::1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Native Anthropic Messages API. Base URL excludes /v1/messages.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
